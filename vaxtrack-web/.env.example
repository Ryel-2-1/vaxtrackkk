# VaxTrack web — Firebase configuration (per environment).
# Copy this file to `.env` and fill in the values from the Firebase console
# (Project settings → Your apps → SDK setup and configuration).
#
# NOTE: These Firebase web keys are PUBLIC client identifiers, not secrets —
# access is controlled by Firestore/Storage security rules, not by hiding the
# key. They are kept per-environment so dev/staging/prod can point at different
# Firebase projects. `.env` is gitignored; this `.env.example` is committed.
#
# src/firebase.js reads these at runtime and fails fast, naming any missing key.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Valhalla motorcycle routing. No API key or billing account for the public
# demo endpoint. Calls are user-initiated and paced; review its fair-use policy
# before rollout: https://valhalla.github.io/valhalla/start/introduction/
# Omit this variable to use the default below. An empty value disables routing.
# For another HTTPS endpoint, also update connect-src in vite.config.js and
# netlify.toml. Road flags are checked before saving; no car fallback is used.
VITE_MOTORCYCLE_ROUTING_URL=https://valhalla1.openstreetmap.de

# Firebase App Check (web) — reCAPTCHA Enterprise site key for THIS project's
# web app (Firebase console → App Check → Apps). Optional: when absent, App
# Check is not initialised and nothing changes. A site key is public.
# Enforcement is a separate, per-project switch (functions/.env.<projectId>:
# ENFORCE_APP_CHECK=true, plus Firestore/Storage in the console).
VITE_APPCHECK_RECAPTCHA_SITE_KEY=
# Local development only: print an App Check debug token to the browser
# console so it can be registered in the Firebase console.
VITE_APPCHECK_DEBUG=

# Departure planner in Dispatcher → Cargo Loading: requested arrival times +
# Valhalla motorcycle travel times from the hub (Admin → Settings → Routing),
# a suggested stop order, and "Use this plan" (saves the trip route and planned
# arrivals the delivery timing uses). Read at BUILD time: true shows it,
# anything else hides it. Recommended: true for staging; production once demoed.
VITE_DEPARTURE_PLANNER_ENABLED=false
