rules_version = '2';

// VaxTrack Cloud Storage security rules.
//
// DEPLOYED TO STAGING (vaxtrack-staging) only. Production (vaxtrack-bef1b) has
// no Storage bucket provisioned and these rules have never been released there.
//
// The ONLY object paths these rules permit, for read or write:
//   proof_of_delivery/{orderId}/proof.jpg
//   invoices/{orderId}/invoice.jpg
// where {orderId} is the Firestore orders/ document ID. Everything else in the
// bucket — any other name, extension, case or nesting — is denied.
//
// One deterministic object per order means a retry overwrites its own failed
// attempt instead of leaving an orphan behind, which matters because delete is
// denied to everyone. The name is pinned HERE, not only in the client, so that
// is a server-side guarantee rather than a convention a modified client could
// ignore.
//
// LIMITATION: Storage rules cannot inspect image pixels/EXIF — they can only
// gate on size + contentType and cross-check the order doc in Firestore. Deeper
// validation (e.g. that the photo is genuinely a delivery) is out of scope.
//
// The creator read branch requires isApproved(), not merely signedIn(). It used
// to accept any signed-in user whose uid matched the order's createdByUid, so a
// sales rep who had since been DISABLED or REJECTED kept read access to the
// delivery-evidence photos of every order they ever raised. Every role helper
// in firestore.rules already gates on approved standing; this brings Storage
// into line. Access follows current standing, not past authorship.
//
// The assigned rider can also READ their own order's evidence. That is not a
// convenience: ImageUploadService does `putFile(...)` then `getDownloadURL()`
// on the same ref and returns the URL for proof_screen to write to Firestore.
// With upload allowed but every rider read denied, the first call succeeded and
// the second failed — leaving the object stored in the bucket with no URL
// recorded anywhere, and no way for the rider to finish the proof step. The
// grant is scoped by `isAssignedRider`, so it covers only the order they are
// CURRENTLY assigned to.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    // Caller's own users doc (cross-service read into Firestore).
    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function isApproved() { return signedIn() && userDoc().status == 'approved'; }
    function isAdmin()      { return signedIn() && userDoc().role == 'admin' && isApproved(); }
    function isDispatcher() { return signedIn() && userDoc().role == 'dispatcher' && isApproved(); }
    function isRider()      { return signedIn() && userDoc().role == 'rider' && isApproved(); }

    // The order doc for a given path {orderId}.
    function orderDoc(orderId) {
      return firestore.get(/databases/(default)/documents/orders/$(orderId)).data;
    }

    function isImageUnder10MB() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // The one identity test used by BOTH write and read on a piece of evidence:
    // an approved rider who is the order's CURRENTLY assigned rider. Reading
    // `assignedRiderId` live from the order doc is what makes reassignment take
    // effect immediately — a rider who has been replaced loses access on their
    // next request, with nothing to revoke.
    //
    // Sharing one helper is deliberate: if write and read each restated the
    // condition, one could later be relaxed without the other.
    function isAssignedRider(orderId) {
      return isRider() && orderDoc(orderId).assignedRiderId == request.auth.uid;
    }

    // --- one object per order ---
    //
    // The exact object names the Rider app writes. Leaving {fileName} free made
    // the deterministic naming a client CONVENTION rather than a guarantee: an
    // assigned, approved rider who bypassed the app could write
    // proof_of_delivery/{orderId}/arbitrary.jpg, then another.jpg, then a
    // timestamped name, accumulating objects under one order that nobody can
    // ever remove — delete is denied to everyone. Proven against the previous
    // rules in the emulator before this was added: five differently-named
    // uploads under a single order, all accepted.
    //
    // Comparison is exact, so it is also case-sensitive and extension-exact:
    // 'Proof.jpg' and 'proof.png' are simply different strings and fail. A
    // nested child path never reaches here at all — {fileName} matches exactly
    // one segment, so deeper paths fall through to the catch-all and are denied.
    //
    // Applied to READ as well as write. The contract is which object paths may
    // exist and be served, not merely which may be created; pinning only the
    // write half is how the two would drift apart later.
    //
    // Must stay identical to kProofFileName / kInvoiceFileName in
    // vaxtrack_mobile/lib/utils/proof_validation.dart.
    function canonicalProofFile()   { return 'proof.jpg'; }
    function canonicalInvoiceFile() { return 'invoice.jpg'; }

    // --- evidence replacement policy ---
    //
    // Deliberately generous BEFORE the evidence is recorded and closed after.
    //
    // A submission is two steps — upload the object, then write the metadata —
    // and the second can fail on its own. If the first attempt's object were
    // frozen in place, a rider whose save failed would be stuck: they could
    // neither replace the photo nor delete it. So while the order carries no
    // finalized metadata, the assigned rider may overwrite the canonical object
    // as often as a retry needs. The moment the metadata is recorded, the
    // object it refers to stops being a draft and becomes the evidence.
    //
    // Both conditions read live from Firestore, so they need nothing revoked:
    // the write stops being permitted on the request after the save lands.

    // The delivery is still under way. A delivered or cancelled order takes no
    // new evidence at all, whether or not it already has some.
    function orderAcceptsEvidence(orderId) {
      return orderDoc(orderId).status != 'delivered'
        && orderDoc(orderId).status != 'cancelled';
    }

    // Set by the Firestore proof/invoice submission. Its presence means the
    // metadata is committed and the object is now referenced by the order.
    function proofIsFinalized(orderId) {
      return 'proofSubmittedAt' in orderDoc(orderId);
    }
    function invoiceIsFinalized(orderId) {
      return 'invoiceSubmittedAt' in orderDoc(orderId);
    }

    // Proof-of-delivery photo: exactly one object per order, written only by
    // the rider the order is assigned to and only while the delivery is live
    // and unproven; read by admin, dispatcher, the sales rep who created the
    // order, or that rider.
    //
    // The name check comes first on both rules — it is a string comparison, so
    // a request for a non-canonical name is refused without spending any
    // cross-service firestore.get.
    match /proof_of_delivery/{orderId}/{fileName} {
      allow write: if fileName == canonicalProofFile()
        && isAssignedRider(orderId)
        && isImageUnder10MB()
        && orderAcceptsEvidence(orderId)
        && !proofIsFinalized(orderId);
      allow read: if fileName == canonicalProofFile()
        && (
          isAdmin()
          || isDispatcher()
          || (isApproved() && orderDoc(orderId).createdByUid == request.auth.uid)
          || isAssignedRider(orderId)
        );
    }

    // Rider's photo of the paper invoice — same access pattern as proof, with
    // its own canonical name and its own finalization marker so recording one
    // does not lock the other.
    match /invoices/{orderId}/{fileName} {
      allow write: if fileName == canonicalInvoiceFile()
        && isAssignedRider(orderId)
        && isImageUnder10MB()
        && orderAcceptsEvidence(orderId)
        && !invoiceIsFinalized(orderId);
      allow read: if fileName == canonicalInvoiceFile()
        && (
          isAdmin()
          || isDispatcher()
          || (isApproved() && orderDoc(orderId).createdByUid == request.auth.uid)
          || isAssignedRider(orderId)
        );
    }

    // Deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
